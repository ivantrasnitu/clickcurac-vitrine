# Site réalisé avec ClickCurac : toutes les pages passent par index.php (contenu géré dans le backoffice).
# Fichier identique pour tous les restaurants.
DirectoryIndex index.php
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Installation avec Git : le dossier .git n'est jamais servi.
  RewriteRule (^|/)\.git - [F,L]
  # Fichiers cachés (sauf .well-known, pour le certificat) et sauvegardes oubliées : jamais servis.
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(sql|bak|old|orig|save|swp|nouveau|tar|gz|tgz|zip|7z|rar|env|log|ini|conf|sh|pem|key)$ - [F,L,NC]
  # Aucun autre script que index.php (un fichier PHP oublié ou déposé par un pirate n'est jamais exécuté).
  # (les anciennes adresses comme menu.php ou blog.php, qui n'existent plus en fichier, passent par index.php).
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond %{REQUEST_URI} !^/index\.php$
  RewriteRule \.(php[0-9]?|phtml|phar|cgi|pl|py)$ - [F,L,NC]
  # Nom de domaine valide seulement (pas de redirection vers un domaine inventé).
  RewriteCond %{HTTP_HOST} !^[a-z0-9.-]+(:[0-9]+)?$ [NC]
  RewriteRule ^ - [F,L]
  # Toujours en https, sans « www ».
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>
